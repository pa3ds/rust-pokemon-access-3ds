### Italian machine translation of `../en/zones.ftl` (2026-11-01), a baseline for a translator to
### correct. The English file says which part of which place each name is; `$place` is the game's
### own name for the place, read from the ROM. A name missing here is said in English.

part-0x2e = { $place } nord
part-0x2f = { $place } sud
part-0x30 = { $place }
part-0x31 = Altopiano di { $place }
part-0xdb = { $place } nord-ovest
part-0xdc = { $place } nord-est
part-0xdd = { $place } sud-ovest
part-0xde = { $place } sud-est
part-0x1dd = Campo di bacche nord-ovest di { $place }
part-0x211 = Campo di bacche nord-est di { $place }
part-0x212 = Campo di bacche sud-ovest di { $place }
part-0x213 = Campo di bacche sud-est di { $place }
