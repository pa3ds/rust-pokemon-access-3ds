amie-motion-378-eat = { $pokemon }把双臂微微向前向后摆动，身体微微摇晃。
amie-motion-378-happyB = { $pokemon }把双臂垂到身体两侧，脸上的点点闪了一下变暗。然后又把双臂抬起伸开。
amie-motion-378-hate = { $pokemon }把双臂向两侧大大张开，脸上的点点变暗。然后把双臂收回来。

# Registeel
amie-motion-379-drowse = { $pokemon }让双臂下沉，脸上的点点变暗。过了一会儿，点点又亮起来，它把双臂甩开。
amie-motion-379-eat = { $pokemon }把双臂微微向内向外摆动，手指屈伸。
amie-motion-379-happyB = { $pokemon }让脸上的点点闪烁，把双臂甩得稍宽一些。然后又让它们垂下。
amie-motion-379-hate = { $pokemon }把双臂向外抬起，手指蜷起，脸上的点点闪了一下变暗。然后又放下双臂。

# Latias
amie-motion-380-drowse = { $pokemon }闭着眼睛垂下头，沉得更低。然后把脖子猛地抬高，四处张望。
amie-motion-380-eat = { $pokemon }仰起头咀嚼。然后继续咀嚼，头一上一下。
amie-motion-380-happyA = { $pokemon }翅膀向后掠，向前低下身。然后把脖子伸得高高的，仰起头。
amie-motion-380-happyB = { $pokemon }向下俯冲到低处。然后向上窜得很高，头都看不见了，再落回来。
amie-motion-380-happyC = { $pokemon }呼地向上飞出画面。然后从低处贴着地面俯冲回来，再直直升起。
amie-motion-380-hate = { $pokemon }侧身避开，把头转开。然后低着头落得低低的，再升起来。
amie-motion-380-lonely = { $pokemon }转向一边仰望，翅膀拖在身后。过了一会儿，转回来。
amie-motion-380-mad = { $pokemon }举起翅膀，猛地向下沉。然后又弹起来，再一下一上沉浮一次。
amie-motion-380-moveA = { $pokemon }把脖子伸向一边，朝那边看。然后转回来面朝前方。
amie-motion-380-moveC = { $pokemon }微微升起，把翅膀左右倾斜。然后落回去。
amie-motion-380-playA = { $pokemon }左右摇晃，头向两边歪，双脚踢动。
amie-motion-380-sleep = { $pokemon }整个沉下去，平平地趴在地上。然后抬起头，睁开眼睛，又升起来。
amie-motion-380-touch = { $pokemon }把一只小手臂向旁边抬起。然后歪着头摇晃。

# Latios
amie-motion-381-drowse = { $pokemon }垂下头，沉得更低。然后猛地直起身，脖子伸得高高的，再向前深深点头。
amie-motion-381-eat = { $pokemon }仰起头咀嚼。然后点着头，向两边歪头。
amie-motion-381-happyA = { $pokemon }低下头，把翅膀高高举起，双臂伸开。然后又抬起头。
amie-motion-381-happyB = { $pokemon }俯冲到一边，飞出画面。然后头朝前俯冲回来，再高高升起。
amie-motion-381-happyC = { $pokemon }窜出画面，头朝前俯冲着飞过，做了两次。然后升得很高，头都不见了，再安定下来。
amie-motion-381-hate = { $pokemon }向上向后窜去，直到头看不见。然后飘回原来的位置。
amie-motion-381-lonely = { $pokemon }转开身，让脖子越垂越低。过了一会儿，转回来面朝前方。
amie-motion-381-mad = { $pokemon }低着头压得低低的。然后把脖子伸得高高的立起身，双臂向外甩开。
amie-motion-381-moveA = { $pokemon }把脖子和身体转向一边，朝那边看。然后转回来面朝前方。
amie-motion-381-moveC = { $pokemon }左右倾斜，向两边甩开双臂。然后直直安定下来。
amie-motion-381-playA = { $pokemon }翅膀高高举起，向前倾得很远。然后向后摇，把头抬起。
amie-motion-381-sleep = { $pokemon }沉下去，平平地趴在地上。然后离地升起一会儿，又趴回去。
amie-motion-381-touch = { $pokemon }举起一只手臂，把手举着。然后又放下。

# Kyogre
amie-motion-382-eat = { $pokemon }把长着牙的嘴张得大大的，再啪地合上。然后向前低下咀嚼，微微摇晃。
amie-motion-382-happyB = { $pokemon }高高立起，露出白色的肚子，鳍大大张开。然后又沉下去。
amie-motion-382-hate = { $pokemon }张大嘴巴龇着牙。然后把尾鳍在头后高高举起，再放下。

# Groudon
amie-motion-383-eat = { $pokemon }仰起头，稍稍张开嘴。然后低下头咀嚼。
amie-motion-383-happyB = { $pokemon }把头转开。然后张大嘴巴把头向后一仰，再又低下。
amie-motion-383-hate = { $pokemon }把头向前一伸，张大巨大的嘴咆哮。然后又合上嘴。

# Rayquaza
amie-motion-384-drowse = { $pokemon }低下头，合上嘴，头垂着点动。然后张着嘴把头猛地抬起。
amie-motion-384-eat = { $pokemon }张大嘴巴把头抬起。然后低下头咀嚼，嘴一张一合。
amie-motion-384-happyB = { $pokemon }把头低得低低的。然后张大嘴巴把头高高抬起，双臂张开。
amie-motion-384-hate = { $pokemon }低下头扭开身，把长长的身体盘起来。然后把脖子笔直向上伸，再张着嘴把头俯冲下来。
amie-motion-384-mad = { $pokemon }低下头张着嘴向前猛冲，长长的身体从旁边扫过。然后张大嘴巴立起身。

# Jirachi
amie-motion-385-drowse = { $pokemon }把星星形的头低下，闭上眼睛，长长的丝带垂到地上。然后猛地直起身，把丝带甩开。
amie-motion-385-eat = { $pokemon }张开嘴微笑，丝带大大展开。然后咀嚼时把头左右歪动。
amie-motion-385-happyB = { $pokemon }歪着头开心地微笑。然后升起来在空中整个转了一圈，丝带飞旋，面朝前方落地。
amie-motion-385-hate = { $pokemon }转开身弓起腰，把丝带紧紧裹在自己身上。然后让它们落下，又把它们大大展开。

# Deoxys
amie-motion-386-eat = { $pokemon }把长长的手臂在胸前卷起，保持住。然后一只手臂横扫过身体中间，再让双臂都垂下。
amie-motion-386-happyB = { $pokemon }把长长的手臂向两侧大幅甩开，保持住。然后让它们落回身体两侧。
amie-motion-386-hate = { $pokemon }弯着腿蹲得低低的，双臂向两侧卷曲伸出。然后又站直，让双臂垂下。
amie-motion-386-1-eat = { $pokemon }把一只长长的手臂在胸前盘成一圈，保持住。然后让手臂松开垂下。
amie-motion-386-1-happyB = { $pokemon }把长长的、像丝带一样的手臂向两侧大幅甩开。然后让它们落回身体两侧。
amie-motion-386-1-hate = { $pokemon }弯着腿蹲得低低的，长长的手臂向两侧甩开。然后站直，让双臂摆回下面。
amie-motion-386-2-eat = { $pokemon }把一只粗壮的手臂从身体中间向上卷到胸前，保持住。然后把手臂放下垂在身旁。
amie-motion-386-2-happyB = { $pokemon }把粗壮的外侧手臂向两侧大幅抬起。然后放回身体两侧。
amie-motion-386-2-hate = { $pokemon }低着头向前弓身，把粗壮的手臂横在身前弯起。然后站直，让它们垂下。
amie-motion-386-3-eat = { $pokemon }把一只细细的手臂在胸前绕成一圈，保持住。然后把手臂放回身旁。
amie-motion-386-3-happyB = { $pokemon }把细长的手臂慢慢向两侧大幅甩开。然后让它们弯曲着落回身体两侧。
amie-motion-386-3-hate = { $pokemon }低下身，把细细的手臂在身前弯成圈。然后站起来，把手臂向外一甩，再让它们垂下。
