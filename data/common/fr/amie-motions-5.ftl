# Golurk
amie-motion-623-eat = { $pokemon } renverse la tête en arrière. Puis il plie son énorme corps en avant et baisse la tête pour manger.
amie-motion-623-happyB = { $pokemon } balance son énorme corps et ses épaules d'un côté à l'autre, en s'abaissant entre les deux.
amie-motion-623-hate = { $pokemon } lève les épaules tandis que ses marques jaunes lumineuses s'éteignent. Puis les marques se rallument.

# Pawniard
amie-motion-624-drowse = { $pokemon } ferme les yeux, ses bras s'affaissent, et sa tête tombe très loin en avant. Puis il se réveille en sursaut, les bras écartés et la tête penchée.
amie-motion-624-eat = { $pokemon } baisse la tête très loin en avant, si bien que seul le dessus rouge de sa tête se voit. Puis il la relève.
amie-motion-624-happyB = { $pokemon } se met en boule et saute. Puis il retombe penché d'un côté, un bras-lame levé bien haut, et se redresse.
amie-motion-624-hate = { $pokemon } se détourne et balance la lame de sa tête en avant, en levant un genou. Puis il lance un bras en avant et donne un coup de pied sur le côté.

# Bisharp
amie-motion-625-eat = { $pokemon } ramène un bras-lame en travers de sa poitrine jusqu'à son visage et le garde ainsi. Puis il baisse le bras.
amie-motion-625-happyB = { $pokemon } renverse la tête en arrière et pose ses bras-lames sur ses hanches, les pieds bien écartés. Puis il se tient de nouveau droit.
amie-motion-625-hate = { $pokemon } s'accroupit, les genoux pliés, et croise ses deux bras-lames sur sa poitrine. Puis il se redresse.

# Bouffalant
amie-motion-626-drowse = { $pokemon } bâille et laisse sa tête s'abaisser. Puis sa tête roule d'un côté, en inclinant ses cornes, et il la relève.
amie-motion-626-eat = { $pokemon } baisse la tête jusqu'à ce que son visage disparaisse sous ses poils hirsutes. Puis il la relève et mâche.
amie-motion-626-happyB = { $pokemon } lève la tête bien haut, la bouche ouverte, et la balance d'un côté à l'autre. Puis il la rebaisse.
amie-motion-626-hate = { $pokemon } baisse la tête et la détourne, cachant son visage sous ses poils. Puis il relève la tête d'un coup, la bouche ouverte.
amie-motion-626-mad = { $pokemon } baisse la tête et gratte le sol d'un sabot avant. Puis il incline ses cornes d'un côté puis de l'autre, et relève la tête.
amie-motion-626-moveC = { $pokemon } baisse bien la tête jusqu'à cacher son visage. Puis il la relève et incline ses cornes d'un côté puis de l'autre.
amie-motion-626-respond = { $pokemon } lève la tête pour que ses yeux se voient sous ses poils, et la garde levée.
amie-motion-626-turnA = { $pokemon } détourne son corps d'un côté, la tête basse, jusqu'à montrer son dos hirsute.

# Rufflet
amie-motion-627-drowse = { $pokemon } penche la tête d'un côté tandis que ses yeux se ferment. Puis il ouvre le bec dans un grand bâillement.
amie-motion-627-eat = { $pokemon } ouvre et ferme le bec. Puis il balance la tête, les yeux fermés.
amie-motion-627-happyB = { $pokemon } décolle du sol en battant des ailes, le bec ouvert, et monte très haut. Puis il se pose, les ailes grandes ouvertes, et les replie.
amie-motion-627-hate = { $pokemon } baisse la tête et ferme fort les yeux. Puis il lève ses ailes vers le haut et les écarte, et les replie de nouveau.
amie-motion-627-mad = { $pokemon } baisse bien la tête. Puis il bondit deux fois en battant des ailes, le bec grand ouvert.
amie-motion-627-moveC = { $pokemon } écarte ses ailes sur les côtés et ouvre le bec pour crier. Puis il les étale à plat et les range.

# Braviary
amie-motion-628-drowse = { $pokemon } balance la tête et la laisse tomber en avant, les yeux fermés. Puis sa tête roule d'un côté, et il la relève.
amie-motion-628-eat = { $pokemon } s'accroupit et baisse la tête pour picorer, sa crête blanche penchant en avant. Puis il se relève.
amie-motion-628-happyB = { $pokemon } se tourne de côté et rejette la tête en arrière, le bec ouvert pointé vers le ciel. Puis il refait face à l'avant.
amie-motion-628-hate = { $pokemon } déploie largement ses énormes ailes et les jette bien haut au-dessus de sa tête, le bec ouvert. Puis il les baisse et les replie.
amie-motion-628-mad = { $pokemon } s'accroupit, les ailes rabattues. Puis il s'envole droit vers le haut, et se pose, les ailes grandes ouvertes, avant de les replier.
amie-motion-628-moveC = { $pokemon } s'incline bien bas d'un côté, la tête baissée. Puis il étire son cou droit vers le haut, le bec pointé vers le ciel.

# Vullaby
amie-motion-629-drowse = { $pokemon } enfonce la tête dans sa collerette et laisse ses ailes tomber sur ses flancs. Puis il se réveille en sursaut, en jetant ses ailes en l'air.
amie-motion-629-eat = { $pokemon } hoche la tête dans sa collerette, en agitant ses ailes de haut en bas.
amie-motion-629-happyB = { $pokemon } s'accroupit et saute, en déployant ses ailes. Puis il les lève bien haut au-dessus de sa tête en retombant, et les baisse.
amie-motion-629-hate = { $pokemon } enfonce la tête dans sa collerette, les ailes levées. Puis il relève la tête d'un coup et bat des ailes, les yeux fermés.

# Mandibuzz
amie-motion-630-eat = { $pokemon } lève le bec. Puis il baisse la tête par quelques petits hochements.
amie-motion-630-happyB = { $pokemon } déploie ses ailes bien large et bien haut et rejette la tête en arrière, le bec ouvert. Puis il replie de nouveau ses ailes.
amie-motion-630-hate = { $pokemon } détourne brusquement la tête. Puis il hausse les épaules et baisse la tête, et se redresse lentement.

# Heatmor
amie-motion-631-eat = { $pokemon } balance son long museau par quelques petits hochements, en bougeant à peine.
amie-motion-631-happyB = { $pokemon } se voûte et rabat son museau vers le bas. Puis il se dresse de toute sa hauteur, les bras grands ouverts, et une flamme vacille au bout de son museau.
amie-motion-631-hate = { $pokemon } se penche très loin en avant et souffle une flamme sur le sol. Puis il se cambre sur une jambe et se penche pour souffler de nouveau une flamme.

# Durant
amie-motion-632-eat = { $pokemon } baisse la tête. Puis il la renverse en arrière, les antennes dressées, et ouvre et ferme les mâchoires.
amie-motion-632-happyB = { $pokemon } se dresse de toute sa hauteur sur ses pattes arrière, montrant son ventre pâle, les antennes levées droit en l'air. Puis il retombe.
amie-motion-632-hate = { $pokemon } se tourne d'un côté et s'accroupit tout bas, la tête près du sol et les antennes pointées vers l'extérieur. Puis il se retourne.

# Deino
amie-motion-633-drowse = { $pokemon } bâille et laisse sa tête descendre jusque sur sa poitrine. Au bout d'un moment, il relève la tête.
amie-motion-633-eat = { $pokemon } baisse bien la tête, si bien que ses poils cachent son visage. Puis il la relève.
amie-motion-633-happyB = { $pokemon } baisse la tête. Puis il se dresse de toute sa hauteur et rejette la tête en arrière, la bouche grande ouverte, avant de se rassoir.
amie-motion-633-hate = { $pokemon } balance la tête d'un côté, les yeux serrés. Puis il la balance de l'autre côté et revient.
amie-motion-633-mad = { $pokemon } se cabre et rejette brusquement la tête en arrière, la bouche ouverte. Puis il abat la tête, et la relève d'un coup une fois de plus.
amie-motion-633-moveC = { $pokemon } s'étire de toute sa hauteur, la bouche ouverte. Puis il plonge la tête jusqu'au sol, si bien que seul son dos poilu se voit, et la relève.
amie-motion-633-playA = { $pokemon } baisse bien la tête. Puis il se dresse d'un coup de toute sa hauteur, la bouche grande ouverte, et retombe vite.

# Zweilous
amie-motion-634-drowse = { $pokemon } laisse une tête tomber et pencher de côté contre l'autre. Puis les deux têtes se redressent d'un coup, la bouche ouverte, et se posent de nouveau.
amie-motion-634-eat = { $pokemon } baisse une tête jusqu'au sol pendant que l'autre ouvre la bouche. Puis les têtes échangent, en se baissant tour à tour.
amie-motion-634-happyB = { $pokemon } se cabre sur ses pattes arrière et rejette ses deux têtes en arrière, la bouche grande ouverte. Puis il retombe.
amie-motion-634-hate = { $pokemon } montre les dents et penche ses deux têtes d'un côté. Puis il les baisse ensemble et les penche de l'autre côté.
amie-motion-634-mad = { $pokemon } baisse ses deux têtes et les cogne l'une contre l'autre, en se bousculant d'avant en arrière. Puis il les relève.
amie-motion-634-moveC = { $pokemon } baisse ses deux têtes en avant jusqu'à ce que ses poils cachent ses visages. Puis il les relève.

# Hydreigon
amie-motion-635-drowse = { $pokemon } laisse ses ailes tomber sur les côtés et se balance, en s'abaissant d'un côté. Puis il se cabre et rejette la tête en arrière dans un grand bâillement.
amie-motion-635-eat = { $pokemon } déploie largement ses ailes et baisse la tête. Puis il ramène ses têtes-bras contre sa poitrine, et elles ouvrent la bouche.
amie-motion-635-happyB = { $pokemon } fait de grandes ondulations d'un côté à l'autre, les bras écartés et la bouche ouverte. Puis il se pose au milieu, les ailes grandes ouvertes.
amie-motion-635-hate = { $pokemon } se détourne et écarte brusquement la tête, en jetant ses têtes-bras au loin. Puis il se voûte tout bas, ses ailes s'enroulant autour de lui.
amie-motion-635-mad = { $pokemon } se jette bas d'un côté, les ailes rejetées en arrière. Puis il se cabre bien haut, en déployant ses ailes et en jetant ses têtes-bras au loin.
amie-motion-635-moveC = { $pokemon } plonge bas en un grand arc d'un côté à l'autre. Puis il se cabre en arrière, la tête haute et les têtes-bras jetées au loin.
amie-motion-635-respond = { $pokemon } tourne la tête d'un côté et crie, la bouche ouverte. Puis il refait face à l'avant, et se tourne de ce côté pour crier de nouveau.
amie-motion-635-touch = { $pokemon } se penche en avant et tend ses deux têtes-bras, les ailes levées bien haut derrière lui.
amie-motion-635-turnA = { $pokemon } tourne son corps d'un côté, ses ailes balayant l'air vers le bas en tournant. Il reste tourné ainsi.

# Larvesta
amie-motion-636-eat = { $pokemon } balance son corps duveteux de haut en bas. Puis il penche son avant par petits hochements.
amie-motion-636-happyB = { $pokemon } se dresse debout sur le bout, montrant son dessous brun et ses petits pieds. Puis il bascule en avant sur son visage et se redresse.
amie-motion-636-hate = { $pokemon } tourne tout son corps d'un côté et regarde ailleurs, en restant ainsi un moment. Puis il se retourne face à vous.

# Volcarona
amie-motion-637-eat = { $pokemon } déploie largement ses six ailes et les agite lentement. Puis il les replie près de son corps, derrière lui.
amie-motion-637-happyB = { $pokemon } bat vite des ailes, en les jetant bien larges et en les repliant, encore et encore. Son corps remonte quand elles se ferment.
amie-motion-637-hate = { $pokemon } jette ses ailes bien larges, puis les referme d'un coup. Il les jette bien larges une fois de plus et les replie.

# Cobalion
amie-motion-638-eat = { $pokemon } baisse la tête par petits hochements en mâchant, ses cornes se balançant.
amie-motion-638-happyB = { $pokemon } incline la tête vers vous. Puis il penche la tête très loin d'un côté et se redresse.
amie-motion-638-hate = { $pokemon } baisse la tête et pointe ses cornes vers vous. Puis il rejette la tête en arrière, la bouche ouverte, et refait face à l'avant.

# Terrakion
amie-motion-639-eat = { $pokemon } baisse un peu la tête et ouvre et ferme la bouche en mâchant.
amie-motion-639-happyB = { $pokemon } baisse la tête. Puis il la lève bien haut et ouvre grand la bouche, les yeux fermés, et se pose.
amie-motion-639-hate = { $pokemon } laisse tomber la tête et s'accroupit tout bas sur ses pattes arc-boutées. Puis il se relève lentement.

# Virizion
amie-motion-640-eat = { $pokemon } baisse un peu la tête en mâchant, ses larges cornes penchant en avant.
amie-motion-640-happyB = { $pokemon } se dresse de toute sa hauteur sur ses pattes arrière, les pattes avant repliées. Puis il retombe sur ses quatre pattes.
amie-motion-640-hate = { $pokemon } incline la tête et ses larges cornes d'un côté et s'écarte. Puis il se redresse.

# Tornadus
amie-motion-641-eat = { $pokemon } se penche en avant, les bras sur son nuage, et mâche, la bouche ouverte. Puis il porte une main à sa bouche et recroise les bras.
amie-motion-641-happyB = { $pokemon } décroise les bras et s'élève sur son nuage, en se balançant, les bras écartés et la bouche ouverte. Puis il recroise les bras.
amie-motion-641-hate = { $pokemon } se renverse et s'écarte sur son nuage, les bras croisés, en montrant les dents. Puis il se redresse.
amie-motion-641-1-eat = { $pokemon } balance un peu son corps d'un côté à l'autre et hoche la tête en mâchant.
amie-motion-641-1-happyB = { $pokemon } se balance d'un côté. Puis il lève la tête bien haut, la bouche ouverte, et se pose.
amie-motion-641-1-hate = { $pokemon } tangue fort d'un côté, une jambe lancée au loin. Puis il se dresse de toute sa hauteur, la tête levée, et se pose.

# Thundurus
amie-motion-642-eat = { $pokemon } se penche sur son nuage, un bras pendant, et mâche. Puis il porte une main à sa bouche et croise les bras.
amie-motion-642-happyB = { $pokemon } écarte les bras et s'élève sur son nuage, en penchant d'un côté, la bouche ouverte. Puis il recroise les bras.
amie-motion-642-hate = { $pokemon } garde les bras croisés et s'incline sur son nuage en s'écartant, en montrant les dents. Puis il baisse la tête et se redresse.
amie-motion-642-1-eat = { $pokemon } écarte largement ses bras de nuage et balance la tête, en ouvrant et fermant la bouche pour mâcher.
amie-motion-642-1-happyB = { $pokemon } écarte largement ses bras de nuage et renverse la tête en arrière, la bouche ouverte. Puis il baisse les bras.
amie-motion-642-1-hate = { $pokemon } jette les bras en l'air dans un nuage de vapeur. Puis il les tient écartés sur les côtés, la bouche ouverte, et les baisse.

# Reshiram
amie-motion-643-drowse = { $pokemon } laisse sa tête descendre bas et pendre, sa longue crinière tombante. Puis il relève lentement la tête et ouvre les yeux.
amie-motion-643-eat = { $pokemon } détourne la tête et mâche, la bouche s'ouvrant et se fermant. Puis il baisse la tête par petits hochements.
amie-motion-643-happyB = { $pokemon } rejette la tête en arrière, la bouche ouverte. Puis il refait face à l'avant, en souriant, les deux bras levés sur les côtés.
amie-motion-643-hate = { $pokemon } détourne brusquement la tête et laisse ses bras ballants. Puis il se retourne face à vous.

# Zekrom
amie-motion-644-drowse = { $pokemon } laisse sa tête tomber vers le bas et sur le côté, et somnole ainsi. Puis il redresse la tête d'un coup et regarde devant lui.
amie-motion-644-eat = { $pokemon } lève la tête et mâche, la bouche grande ouverte. Puis il baisse la tête par petits hochements.
amie-motion-644-happyB = { $pokemon } baisse la tête. Puis il l'incline d'un côté, la bouche grande ouverte, et la relève avec un large sourire plein de dents.
amie-motion-644-hate = { $pokemon } tord la tête de côté et regarde vers le bas. Puis il se retourne face à vous.
amie-motion-644-moveB = { $pokemon } tourne la tête très loin d'un côté et la garde ainsi. Puis il refait face à l'avant.

# Landorus
amie-motion-645-eat = { $pokemon } se penche sur son nuage, un bras pendant, et mâche. Puis il porte une main à sa bouche et croise les bras.
amie-motion-645-happyB = { $pokemon } garde les bras croisés et s'élève sur son nuage, en balançant sa queue devant lui. Puis il hoche profondément la tête et se pose.
amie-motion-645-hate = { $pokemon } garde les bras croisés et se renverse sur son nuage, en détournant la tête d'un air renfrogné. Puis il se redresse.
amie-motion-645-1-eat = { $pokemon } lève la tête bien haut, la bouche ouverte. Puis il la baisse et mâche par petits mouvements de tête.
amie-motion-645-1-happyB = { $pokemon } balance sa queue bien haut et d'un côté à l'autre par-dessus son dos. Puis il ferme les yeux de bonheur.
amie-motion-645-1-hate = { $pokemon } baisse bien la tête d'un côté, presque jusqu'au sol. Puis il se cabre, la bouche ouverte, et se pose sur ses quatre pattes.

# Kyurem
amie-motion-646-drowse = { $pokemon } laisse sa tête descendre jusqu'à ce que seul le dessus se voie, et la garde pendante. Puis il relève la tête d'un coup et regarde devant lui.
amie-motion-646-eat = { $pokemon } renverse la tête en arrière, puis la baisse tout bas et mâche. Puis il renverse de nouveau la tête en arrière.
amie-motion-646-happyB = { $pokemon } baisse bien la tête. Puis il la lance vers le haut et en arrière, et la ramène face à l'avant.
amie-motion-646-hate = { $pokemon } balance la tête vers le bas et d'un côté. Puis il la relève et refait face à l'avant.
amie-motion-646-1-drowse = { $pokemon } reste très immobile, en se balançant légèrement, et laisse sa tête descendre un peu plus bas.
amie-motion-646-1-eat = { $pokemon } renverse la tête en arrière et ouvre grand la bouche. Puis il baisse la tête et mâche, en bougeant à peine.
amie-motion-646-1-happyB = { $pokemon } balance la tête tout bas d'un côté. Puis il étire son long cou bien haut, la bouche grande ouverte, et se pose.
amie-motion-646-1-hate = { $pokemon } rejette la tête en arrière, la bouche ouverte. Puis il détourne le visage, les yeux fermés, et regarde de nouveau devant lui.
amie-motion-646-2-drowse = { $pokemon } se balance légèrement d'un côté à l'autre et laisse sa tête dodeliner un peu.
amie-motion-646-2-eat = { $pokemon } renverse la tête en arrière et ouvre grand la bouche. Puis il baisse la tête et mâche par petits hochements.
amie-motion-646-2-happyB = { $pokemon } penche la tête d'un côté. Puis il rejette la tête très loin en arrière, la bouche grande ouverte, et plonge de nouveau en avant.
amie-motion-646-2-hate = { $pokemon } relève la tête d'un coup et en arrière, la bouche ouverte. Puis il la rabaisse et regarde devant lui.

# Keldeo
amie-motion-647-drowse = { $pokemon } baisse la tête jusqu'à ce que sa crinière cache son visage, et s'affaisse d'un côté. Puis il relève la tête d'un coup, en levant une patte avant.
amie-motion-647-eat = { $pokemon } reste immobile et balance légèrement la tête en mâchant.
amie-motion-647-happyB = { $pokemon } bondit sur le côté, les pattes repliées, et retombe la tête basse. Puis il bondit de nouveau très haut, en souriant, et se pose.
amie-motion-647-hate = { $pokemon } rejette la tête en l'air et la détourne, les yeux fermés. Puis il baisse bien la tête et la relève.

# Meloetta
amie-motion-648-drowse = { $pokemon } ferme les yeux, et sa tête tombe d'un côté. Il cligne des yeux en se réveillant, la bouche ouverte, et s'assoupit de nouveau. Puis il se réveille.
amie-motion-648-eat = { $pokemon } ramène ses mains devant sa poitrine et mâche par petits hochements de tête.
amie-motion-648-happyB = { $pokemon } écarte les bras et s'élève un peu, souriant les yeux fermés. Puis il se pose.
amie-motion-648-hate = { $pokemon } ferme fort les yeux et détourne la tête, ses longs cheveux se balançant. Il regarde de nouveau en fronçant les sourcils, puis se détourne encore.

# Genesect
amie-motion-649-eat = { $pokemon } reste immobile et se balance légèrement.
amie-motion-649-happyB = { $pokemon } renverse la tête en arrière et lève ses deux bras sur les côtés. Puis il les baisse.
amie-motion-649-hate = { $pokemon } se voûte en avant, la tête baissée, et jette les deux bras bien larges. Puis il se redresse et les baisse.
