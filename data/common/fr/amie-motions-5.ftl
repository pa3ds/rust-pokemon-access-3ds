amie-motion-561-eat = { $pokemon } baisse ses ailes et s'abaisse. Puis il s'élève, les ailes levées bien haut, et monte et descend.
amie-motion-561-happyB = { $pokemon } s'élève et bat des ailes bien haut. Puis il les déploie largement et les rebat bien haut.
amie-motion-561-hate = { $pokemon } se tord de côté et recule, les ailes repliées l'une contre l'autre. Puis il se tourne face à l'avant et déploie de nouveau ses ailes.
amie-motion-561-mad = { $pokemon } se renverse en arrière. Puis il bat fort des ailes, en les jetant bien haut et bien large.
amie-motion-561-moveC = { $pokemon } fait un tour complet en l'air, en rentrant ses ailes pendant qu'il tourne. Puis il refait face à l'avant et les déploie de nouveau.

# Yamask
amie-motion-562-drowse = { $pokemon } descend lentement vers le sol, les bras ballants. Puis il remonte d'un coup, redescend encore et remonte en flottant.
amie-motion-562-eat = { $pokemon } monte et descend doucement, en levant et baissant un peu ses bras recourbés.
amie-motion-562-happyB = { $pokemon } se détourne et serre son masque dans ses bras. Puis il lève le masque bien haut au-dessus de sa tête, l'abaisse et refait face à l'avant.
amie-motion-562-hate = { $pokemon } file d'un côté et se détourne, serrant son masque contre son corps. Puis il revient en flottant et refait face à l'avant.

# Cofagrigus
amie-motion-563-drowse = { $pokemon } laisse ses mains du haut tomber jusqu'à ce qu'elles pendent, molles. Puis il se penche en avant et se redresse d'un coup, jetant ses mains bien haut.
amie-motion-563-eat = { $pokemon } baisse ses mains du haut et les replie. Puis il les lève bien haut et écarte les doigts.
amie-motion-563-happyB = { $pokemon } lève ses quatre mains bien haut et bien large. Puis il les baisse lentement.
amie-motion-563-hate = { $pokemon } balaie ses mains devant son corps pour se protéger. Il les écarte, puis les ramène de nouveau en travers.
amie-motion-563-mad = { $pokemon } croise ses mains devant son corps. Puis il les jette bien large et bas, avec colère.
amie-motion-563-moveC = { $pokemon } referme lentement ses mains du haut. Puis il les rouvre grand.

# Tirtouga
amie-motion-564-eat = { $pokemon } lève la tête et ouvre grand la bouche. Puis il baisse la tête et mâche en hochant légèrement la tête.
amie-motion-564-happyB = { $pokemon } lève la tête bien haut, la bouche grande ouverte. Puis il balance la tête très bas d'un côté et refait face à l'avant.
amie-motion-564-hate = { $pokemon } tourne la tête d'un côté et la détourne en la relevant, en fronçant les sourcils. Puis il baisse la tête et refait face à l'avant.

# Carracosta
amie-motion-565-eat = { $pokemon } ouvre grand la bouche une fois. Puis il mâche, en montant et descendant doucement.
amie-motion-565-happyB = { $pokemon } se redresse et balance largement ses longues nageoires sur les côtés. Puis il les ramène.
amie-motion-565-hate = { $pokemon } se détourne et hausse les épaules. Puis il balance largement ses longues nageoires et refait face à l'avant.

# Archen
amie-motion-566-drowse = { $pokemon } baisse de plus en plus la tête vers le sol. Puis il se redresse d'un coup, le bec ouvert, et bat des ailes.
amie-motion-566-eat = { $pokemon } ouvre le bec et déploie largement ses ailes. Puis il baisse bien la tête pour picorer.
amie-motion-566-happyB = { $pokemon } baisse bien la tête. Puis il bondit très haut, le bec ouvert, retombe et bat largement des ailes.
amie-motion-566-hate = { $pokemon } se cabre, le bec grand ouvert, et bat des ailes de haut en bas. Puis il se rassoit.

# Archeops
amie-motion-567-eat = { $pokemon } rejette la tête en arrière, le bec ouvert. Puis il baisse la tête et mâche.
amie-motion-567-happyB = { $pokemon } s'accroupit, puis bondit très haut, les ailes grandes ouvertes. Il retombe en s'abaissant bien bas et se redresse.
amie-motion-567-hate = { $pokemon } se cabre, le bec ouvert, et déploie ses ailes bien haut. Puis il baisse bien la tête et se voûte en avant.

# Trubbish
amie-motion-568-drowse = { $pokemon } ferme à moitié les yeux et s'affaisse un peu. Puis il bascule sur le côté et se redresse en se balançant.
amie-motion-568-eat = { $pokemon } mâche en hochant légèrement la tête. Puis il ouvre grand la bouche, et continue de mâcher.
amie-motion-568-happyB = { $pokemon } bondit très haut, les yeux fermés, avec un grand sourire, en jetant les bras en l'air. Puis il retombe.
amie-motion-568-hate = { $pokemon } tourne le dos. Après un moment, il se retourne et refait face à l'avant.
amie-motion-568-mad = { $pokemon } fait la moue et se tasse. Puis il jette les bras en l'air et ouvre grand la bouche.
amie-motion-568-moveC = { $pokemon } lève les bras, la bouche ouverte. Puis il se balance d'un côté à l'autre en agitant les bras.
amie-motion-568-playA = { $pokemon } se redresse d'un petit bond et lève les bras, en ouvrant grand la bouche. Puis il se rassoit.
amie-motion-568-respond = { $pokemon } écarte les deux touffes sur sa tête et incline son corps d'un côté.
amie-motion-568-turnA = { $pokemon } se tourne de côté et reste ainsi.

# Garbodor
amie-motion-569-eat = { $pokemon } se dresse de toute sa hauteur et ouvre la bouche. Puis il mâche, en se balançant doucement d'un côté à l'autre.
amie-motion-569-happyB = { $pokemon } se penche d'un côté. Puis il lève un bras bien haut et tend l'autre bien large, et les rabaisse.
amie-motion-569-hate = { $pokemon } se tasse tout bas, les bras ramenés contre lui. Puis il se dresse et jette un bras sur le côté.

# Zorua
amie-motion-570-drowse = { $pokemon } hoche la tête en avant, les yeux fermés. Puis il bascule sur le côté et se relève d'un bond, bien réveillé.
amie-motion-570-eat = { $pokemon } mâche en hochant légèrement la tête, en ouvrant et fermant la bouche.
amie-motion-570-happyA = { $pokemon } ferme les yeux avec un sourire et penche la tête d'un côté à l'autre.
amie-motion-570-happyB = { $pokemon } s'accroupit, les yeux fermés. Puis il saute très haut avec un grand sourire et retombe accroupi.
amie-motion-570-happyC = { $pokemon } saute très haut, les yeux fermés et souriant, et tournoie en l'air. Puis il retombe face à l'avant.
amie-motion-570-hate = { $pokemon } ferme fort les yeux et secoue la tête de droite à gauche.
amie-motion-570-lonely = { $pokemon } tourne le dos et baisse bien la tête, et reste ainsi.
amie-motion-570-mad = { $pokemon } baisse la tête et lance un regard noir. Puis il détourne brusquement la tête et se retourne.
amie-motion-570-moveA = { $pokemon } tourne la tête pour regarder d'un côté, puis de l'autre. Puis il refait face à l'avant.
amie-motion-570-moveC = { $pokemon } ferme les yeux et balance la tête et le corps d'un côté à l'autre. Puis il rouvre les yeux.
amie-motion-570-moveD = { $pokemon } s'accroupit, puis bondit si haut qu'il disparaît de la vue. Puis il retombe sur ses pieds.
amie-motion-570-playA = { $pokemon } rebondit et penche légèrement la tête, et cligne des yeux.
amie-motion-570-sleep = { $pokemon } est couché à plat et dort. De temps en temps, il rentre la tête, puis la relève, les yeux toujours fermés.
amie-motion-570-touch = { $pokemon } se penche d'un côté et lève une patte avant.

# Zoroark
amie-motion-571-drowse = { $pokemon } fléchit les genoux et laisse tomber sa tête en avant. Puis il se redresse lentement.
