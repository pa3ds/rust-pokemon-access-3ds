# Whirlipede
amie-motion-544-eat = { $pokemon } ferme son œil et balance son corps rond d'un côté à l'autre en mâchant. Puis il ouvre l'œil.
amie-motion-544-happyB = { $pokemon } ferme son œil et bondit droit vers le haut, hors de vue. Puis il retombe en culbutant, atterrit et ouvre l'œil.
amie-motion-544-hate = { $pokemon } plisse son œil en lançant un regard noir et se balance très légèrement.

# Scolipede
amie-motion-545-eat = { $pokemon } balance la tête de haut en bas en mâchant, et ses longues cornes se balancent avec elle.
amie-motion-545-happyB = { $pokemon } balance la tête très loin d'un côté. Puis il rejette la tête en arrière, balayant ses cornes d'un côté à l'autre, et se redresse.
amie-motion-545-hate = { $pokemon } secoue fort la tête de droite à gauche, en balançant ses cornes. Puis il refait face à l'avant.

# Cottonee
amie-motion-546-drowse = { $pokemon } ferme les yeux et s'affaisse lentement, ses feuilles tombantes. Puis il se redresse en sursaut, les yeux grands ouverts et les feuilles dressées.
amie-motion-546-eat = { $pokemon } penche vers vous sa tête de coton duveteuse. Puis il se redresse et mâche.
amie-motion-546-happyB = { $pokemon } sourit, les yeux fermés, et s'élève bien haut en battant des feuilles. Puis il redescend doucement.
amie-motion-546-hate = { $pokemon } se recroqueville, les yeux serrés, et s'incline d'un côté. Puis il s'incline de l'autre et se pose.
amie-motion-546-mad = { $pokemon } fronce les sourcils et s'incline d'un côté, une feuille levée bien haut. Puis il s'incline de l'autre côté et lève l'autre feuille.
amie-motion-546-moveC = { $pokemon } dérive très loin d'un côté jusqu'à presque sortir de la vue. Puis il revient en flottant là où il était.
amie-motion-546-playA = { $pokemon } s'élève et bat des feuilles de haut en bas. Puis il redescend et ferme les yeux.
amie-motion-546-respond = { $pokemon } ferme les yeux et s'abaisse. Puis il remonte, les yeux ouverts et les feuilles levées.
amie-motion-546-turnA = { $pokemon } vous tourne le dos et replie ses feuilles contre lui.

# Whimsicott
amie-motion-547-drowse = { $pokemon } ferme les yeux et s'enfonce lentement dans son coton en hochant la tête. Puis il se redresse d'un coup, les yeux grands ouverts et la bouche ouverte.
amie-motion-547-eat = { $pokemon } plonge la tête dans son coton. Puis il relève le visage et mâche, la bouche ouverte.
amie-motion-547-happyB = { $pokemon } s'accroupit et bondit en faisant un saut périlleux en l'air. Puis il retombe sur ses pieds, la bouche ouverte en un sourire.
amie-motion-547-hate = { $pokemon } ferme les yeux et enfonce la tête dans son coton. Puis il relève la tête.
amie-motion-547-mad = { $pokemon } cache la tête dans son coton. Puis il bondit bien haut en fronçant les sourcils et secoue la tête de droite à gauche.
amie-motion-547-moveC = { $pokemon } incline sa tête et son coton très loin d'un côté, la bouche ouverte. Puis il se redresse.

# Petilil
amie-motion-548-drowse = { $pokemon } ferme les yeux et s'affaisse très loin d'un côté. Puis il se redresse d'un coup, les yeux grands ouverts, ses feuilles pointées droit vers le haut.
amie-motion-548-eat = { $pokemon } ferme les yeux et se penche en avant, ses feuilles s'écartant largement. Puis il se redresse avec un sourire et mâche.
amie-motion-548-happyB = { $pokemon } se penche en avant, les yeux fermés en un sourire. Puis il saute bien haut et retombe, ses feuilles se balançant.
amie-motion-548-hate = { $pokemon } se détourne et rabat ses feuilles sur sa tête. Puis il se retourne face à vous, et ses feuilles se redressent d'un coup.

# Lilligant
amie-motion-549-drowse = { $pokemon } ferme les yeux et penche lentement sa tête fleurie d'un côté. Il cligne des yeux en se réveillant, puis ses yeux se referment doucement.
amie-motion-549-eat = { $pokemon } tient ses bras-feuilles écartés sur les côtés et balance sa tête fleurie de haut en bas en mâchant.
amie-motion-549-happyB = { $pokemon } écarte ses bras-feuilles et se balance d'un côté à l'autre, souriant les yeux fermés. Puis il se redresse.
amie-motion-549-hate = { $pokemon } serre ses bras-feuilles contre sa poitrine et baisse la tête en fronçant les sourcils. Puis il les baisse de nouveau.
amie-motion-549-mad = { $pokemon } se tourne brusquement de côté, et la longue feuille sur sa tête se balance derrière lui. Puis il se remet face à l'avant.
amie-motion-549-moveC = { $pokemon } replie ses bras-feuilles devant lui et baisse la tête, les yeux fermés. Puis il laisse retomber les bras.

# Basculin
amie-motion-550-eat = { $pokemon } ouvre grand sa bouche pleine de dents et la referme d'un coup, en battant des nageoires. Puis il mord encore et garde la bouche fermée.
amie-motion-550-happyB = { $pokemon } ouvre grand la bouche et bascule sur le côté. Puis il se redresse d'un mouvement, la bouche ouverte.
amie-motion-550-hate = { $pokemon } ferme fort les yeux et s'enfonce bas. Puis il se jette vers le haut, sa bouche pleine de dents grande ouverte, et plonge de nouveau.

# Sandile
amie-motion-551-drowse = { $pokemon } baisse très bas la tête, les yeux fermés, et bâille. Puis sa tête tombe de côté sur le sol, et il se redresse d'un coup.
amie-motion-551-eat = { $pokemon } baisse bien la tête, puis la relève et ouvre grand les mâchoires. Puis il renverse la tête en arrière et les referme d'un coup.
amie-motion-551-happyB = { $pokemon } se cabre, les mâchoires grandes ouvertes, penché d'un côté avec une patte avant levée. Puis il se cabre de l'autre côté et retombe en souriant.
amie-motion-551-hate = { $pokemon } s'accroupit et balance son museau vers le bas d'un côté. Puis il se remet face à l'avant, la bouche ouverte.
amie-motion-551-mad = { $pokemon } se cabre en arrière et rejette la tête en l'air, les mâchoires béantes vers le ciel. Puis il baisse la tête, en montrant toujours les dents.
amie-motion-551-moveC = { $pokemon } ouvre la bouche et penche la tête d'un côté à l'autre. Puis il refait face à l'avant.
amie-motion-551-playA = { $pokemon } se dresse de toute sa hauteur sur ses jambes, la tête bien haut. Puis il s'aplatit près du sol et se redresse d'un bond.

# Krokorok
amie-motion-552-drowse = { $pokemon } laisse sa tête s'affaisser lentement en avant. Puis il relève la tête d'un coup, les bras jetés en l'air, et s'affaisse de nouveau.
amie-motion-552-eat = { $pokemon } baisse la tête, puis la relève, la bouche ouverte. Puis il baisse un peu la tête et mâche.
amie-motion-552-happyB = { $pokemon } rejette la tête en arrière et se tourne à moitié de côté, relevant sa queue derrière lui. Puis il se remet face à l'avant, en souriant.
amie-motion-552-hate = { $pokemon } se tord très bas d'un côté, en fouettant l'air de sa queue bien haut. Puis il se tord de l'autre côté et baisse la tête.

# Krookodile
amie-motion-553-drowse = { $pokemon } laisse tomber sa tête et ses bras. Puis il s'affaisse très loin en avant, et se redresse d'un coup, les griffes écartées.
amie-motion-553-eat = { $pokemon } ouvre grand les mâchoires, puis baisse la tête en mâchant. Puis il se redresse.
amie-motion-553-happyB = { $pokemon } baisse la tête, puis la rejette en arrière, les mâchoires grandes ouvertes et les bras écartés. Puis il regarde de nouveau devant lui.
amie-motion-553-hate = { $pokemon } se voûte très loin en avant. Puis il se cabre, les mâchoires grandes ouvertes et les griffes levées.

# Darumaka
amie-motion-554-drowse = { $pokemon } laisse ses yeux se fermer à moitié et s'affaisse. Puis il se redresse en sautillant, les bras jetés en l'air, et saute encore une fois.
amie-motion-554-eat = { $pokemon } se penche en avant, les bras tendus. Puis il se rebalance droit et mâche, les yeux fermés.
amie-motion-554-happyB = { $pokemon } bondit très haut, les bras écartés, et se tord en l'air. Puis il retombe, souriant les yeux fermés.
amie-motion-554-hate = { $pokemon } serre les bras contre lui et s'accroupit tout bas, les yeux serrés. Puis il se relève.
amie-motion-554-mad = { $pokemon } s'accroupit en fronçant les sourcils. Puis il se balance fort d'un côté à l'autre, en agitant les bras, et saute les bras écartés.
amie-motion-554-moveC = { $pokemon } rentre les bras et se balance d'un côté à l'autre. Puis il bascule très loin en avant et se rebalance droit.

# Darmanitan
amie-motion-555-drowse = { $pokemon } s'affaisse, les yeux mi-clos, et bâille largement. Puis il se balance d'un côté à l'autre, les yeux tombants.
amie-motion-555-eat = { $pokemon } ouvre grand les mâchoires et les referme d'un coup. Puis il se balance d'un côté et revient en mâchant.
amie-motion-555-happyB = { $pokemon } se cabre sur ses pattes arrière et agite ses gros poings. Puis il retombe dessus, la bouche grande ouverte.
amie-motion-555-hate = { $pokemon } se baisse. Puis il se cabre, les mâchoires pleines de dents béantes et ses sourcils de flamme dressés bien haut.

# Maractus
amie-motion-556-drowse = { $pokemon } laisse tomber sa tête en avant. Puis il se redresse d'un coup, les bras jetés en l'air, et se tord, balançant ses grosses fleurs.
amie-motion-556-eat = { $pokemon } ouvre la bouche et mâche, en balançant la tête de haut en bas.
amie-motion-556-happyB = { $pokemon } bondit très haut, les bras grands ouverts. Puis il retombe et se tord, si bien que ses grosses fleurs tournent autour de lui.
amie-motion-556-hate = { $pokemon } se détourne et tourne le dos, ses grosses fleurs tournoyant. Puis il se remet face à l'avant.
amie-motion-556-moveC = { $pokemon } fait un tour complet sur lui-même, en balançant ses grosses fleurs. Puis il refait face à l'avant, les bras écartés, en souriant.
amie-motion-556-respond = { $pokemon } ouvre la bouche. Puis il se penche d'un côté et incline la tête.
amie-motion-556-turnA = { $pokemon } se retourne complètement et reste dos tourné.

# Dwebble
amie-motion-557-drowse = { $pokemon } ferme les yeux et s'affaisse en avant sous son rocher. Puis il se redresse, ouvre les yeux et regarde d'un côté à l'autre.
amie-motion-557-eat = { $pokemon } ouvre et ferme sa petite bouche en mâchant, et se balance légèrement sous son rocher.
amie-motion-557-happyB = { $pokemon } se dresse et jette ses deux pinces très écartées, souriant les yeux fermés. Puis il les rabaisse.
amie-motion-557-hate = { $pokemon } se tapit sous son rocher en fronçant les sourcils. Puis il ressort d'un coup et tend une pince sur le côté.
amie-motion-557-moveC = { $pokemon } ferme les yeux et se balance légèrement d'un côté à l'autre sous son rocher. Puis il ouvre les yeux.

# Crustle
amie-motion-558-drowse = { $pokemon } balance lentement son gros rocher d'un côté à l'autre, les yeux tombants. Puis il s'abaisse et jette ses pinces sur les côtés.
amie-motion-558-eat = { $pokemon } ouvre et ferme la bouche sous son gros rocher, en s'inclinant légèrement en mâchant.
amie-motion-558-happyB = { $pokemon } penche son gros rocher en arrière et lève ses deux pinces bien haut à côté de son visage. Puis il les rabaisse.
amie-motion-558-hate = { $pokemon } penche son rocher en avant et croise ses pinces devant son visage. Puis il les rabaisse.

# Scraggy
amie-motion-559-drowse = { $pokemon } laisse sa grosse tête s'affaisser en avant jusqu'à ce qu'elle pende. Puis il sursaute, les bras écartés, et regarde autour de lui d'un côté à l'autre.
amie-motion-559-eat = { $pokemon } ouvre la bouche, puis hoche sa grosse tête de haut en bas en mâchant.
amie-motion-559-happyB = { $pokemon } saute, les bras grands ouverts et la tête rejetée en arrière. Puis il retombe et saute encore une fois.
amie-motion-559-hate = { $pokemon } ferme fort les yeux et balance sa grosse tête bien bas d'un côté à l'autre. Puis il la relève, la bouche ouverte.
amie-motion-559-mad = { $pokemon } rejette la tête en arrière, les yeux serrés. Puis il la rabat violemment et la relève, la bouche ouverte.
amie-motion-559-moveC = { $pokemon } renverse la tête en arrière, puis la bascule en avant. Puis il rejette la tête en arrière, les bras levés, et la baisse de nouveau.
amie-motion-559-moveD = { $pokemon } baisse la tête en avant. Puis il s'étire, la tête en arrière et les bras grands ouverts, et baisse de nouveau la tête.
amie-motion-559-playA = { $pokemon } se penche d'un côté et agite un bras bien haut à côté de sa tête. Puis il baisse le bras et se redresse.
amie-motion-559-respond = { $pokemon } étire son cou et renverse sa grosse tête en arrière pour regarder en haut.
amie-motion-559-touch = { $pokemon } tend un bras tout droit sur le côté. Puis il baisse bien la tête et se redresse.
amie-motion-559-turnA = { $pokemon } se tourne de côté et reste la tête baissée, regardant vers le bas.

# Scrafty
amie-motion-560-drowse = { $pokemon } balance la tête, les yeux tombants et la bouche s'ouvrant. Puis il rejette la tête en arrière, faisant voler sa crête, et se redresse.
amie-motion-560-eat = { $pokemon } garde les mains sur les hanches et balance la tête en mâchant.
amie-motion-560-happyB = { $pokemon } secoue la tête d'un côté à l'autre, faisant voler sa crête de chaque côté. Puis il refait face à l'avant, la bouche ouverte.
amie-motion-560-hate = { $pokemon } détourne la tête. Puis il se penche en arrière en fronçant les sourcils et lève une main.
amie-motion-560-mad = { $pokemon } se penche en arrière en lançant un regard noir. Puis il projette la tête en avant et vers le bas avec colère, en montrant les dents.

# Sigilyph
