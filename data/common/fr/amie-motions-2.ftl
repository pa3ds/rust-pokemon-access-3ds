amie-motion-201-5-hate = { $pokemon } plisse son œil et s'écarte en penchant d'un côté, sa jambe se balançant. Puis il se redresse.
amie-motion-201-6-eat = { $pokemon } descend et bascule vers l'avant. Puis il remonte et cligne de l'œil.
amie-motion-201-6-happyB = { $pokemon } descend bas, son œil fermé. Puis il rebondit haut et redescend en flottant à sa place.
amie-motion-201-6-hate = { $pokemon } s'écrase bien bas et plisse son œil d'un air renfrogné. Puis il bondit haut et se calme.
amie-motion-201-7-eat = { $pokemon } descend très légèrement et remonte.
amie-motion-201-7-happyB = { $pokemon } roule d'un côté à l'autre comme une roue, penchant loin de chaque côté, son œil courbé en un sourire.
amie-motion-201-7-hate = { $pokemon } ferme fort son œil et se tord d'avant en arrière. Puis il ouvre son œil et fait face.
amie-motion-201-8-eat = { $pokemon } bascule vers l'avant et descend. Puis il remonte.
amie-motion-201-8-happyB = { $pokemon } ferme son œil et penche d'un côté. Puis il roule de l'autre côté jusqu'à être couché à plat, et se redresse d'un coup.
amie-motion-201-8-hate = { $pokemon } plisse son œil d'un air renfrogné et penche à peine d'un côté à l'autre.
amie-motion-201-9-eat = { $pokemon } penche son corps rond vers l'avant et regarde en bas. Puis il se redresse en se balançant et oscille légèrement.
amie-motion-201-9-happyB = { $pokemon } sourit et tourne sur place, penchant en tournant. Puis il refait face.
amie-motion-201-9-hate = { $pokemon } ferme son œil et se retourne la tête en bas, son crochet recourbé au-dessus. Puis il roule sur le côté et se remet à l'endroit.
amie-motion-201-10-eat = { $pokemon } penche d'un côté et descend, regardant le sol. Puis il se redresse et cligne de l'œil.
amie-motion-201-10-happyB = { $pokemon } ferme son œil et tourne complètement, montrant son dos sombre. Puis il penche d'un côté à l'autre et refait face.
amie-motion-201-10-hate = { $pokemon } recule et lance un regard noir, l'œil plissé, penchant son corps d'un côté. Puis il avance de nouveau et se redresse.
amie-motion-201-11-eat = { $pokemon } penche loin vers le bas sa tête ronde. Puis il remonte et ferme lentement son œil.
amie-motion-201-11-happyB = { $pokemon } sourit et tourne deux fois sur lui-même, montrant son dos sombre. Puis il saute haut et retombe bien droit.
amie-motion-201-11-hate = { $pokemon } s'enfonce sur sa jambe pliée et renverse la tête, plissant son œil. Puis il remonte.
amie-motion-201-12-eat = { $pokemon } penche son corps vers l'avant et regarde le sol. Puis il se redresse et cligne de l'œil.
amie-motion-201-12-happyB = { $pokemon } s'écrase en souriant. Puis il bondit haut, fait un tour dans les airs et retombe bien droit.
amie-motion-201-12-hate = { $pokemon } lance un regard noir, l'œil plissé, et tord son visage rond d'un côté. Puis il se remet de face.
amie-motion-201-13-eat = { $pokemon } redresse son corps incliné et penche vers l'avant pour regarder en bas. Puis il se redresse de nouveau.
amie-motion-201-13-happyB = { $pokemon } sourit et tord vivement tout son corps d'avant en arrière, penchant loin d'un côté puis de l'autre. Puis il se calme à la verticale.
amie-motion-201-13-hate = { $pokemon } ferme fort son œil, recule et tourne sur lui-même, montrant son dos sombre. Puis il refait face et se tient droit.
amie-motion-201-14-eat = { $pokemon } penche son anneau vers l'avant et regarde en bas. Puis il se redresse en se balançant et ferme lentement son œil.
amie-motion-201-14-happyB = { $pokemon } rebondit plusieurs fois, son œil joyeusement courbé, son anneau penchant au passage. Puis il se calme.
amie-motion-201-14-hate = { $pokemon } ferme fort son œil et tord son anneau fort d'un côté, puis de l'autre. Puis il refait face.
amie-motion-201-15-eat = { $pokemon } descend son corps rond et regarde le sol. Puis il remonte, balance sa tige sur le côté et ferme son œil.
amie-motion-201-15-happyB = { $pokemon } descend bas en souriant. Puis il bondit haut, balançant sa longue tige sous lui, redescend encore une fois et se calme.
amie-motion-201-15-hate = { $pokemon } ferme son œil et bascule sur le côté, glissant au loin avec sa tige sur le sol. Puis il se redresse et revient.
amie-motion-201-16-eat = { $pokemon } rabaisse sa queue, d'abord tendue sur le côté, et son corps rond monte. Puis il oscille doucement sur place.
amie-motion-201-16-happyB = { $pokemon } bondit haut dans les airs et tourne complètement, montrant son dos sombre. Puis il retombe et atterrit bien droit.
amie-motion-201-16-hate = { $pokemon } ferme son œil et pointe sa queue droit vers le bas. Puis il se retourne la tête en bas haut dans les airs, et se remet lentement à l'endroit.
amie-motion-201-17-eat = { $pokemon } penche sa tête ronde vers l'avant et regarde en bas. Puis il se redresse et cligne de l'œil.
amie-motion-201-17-happyB = { $pokemon } ferme son œil et s'enfonce, pliant sa longue jambe. Puis il se dresse de toute sa taille, penchant sa jambe de l'autre côté, et se calme.
amie-motion-201-17-hate = { $pokemon } ferme son œil et renverse la tête, sa longue jambe se pliant sous lui. Puis il se redresse.
amie-motion-201-18-eat = { $pokemon } penche vers l'avant et regarde le sol. Puis il se redresse en se balançant et oscille légèrement.
amie-motion-201-18-happyB = { $pokemon } s'accroupit, son œil joyeusement courbé. Puis il bondit haut, retombe et se calme.
amie-motion-201-18-hate = { $pokemon } louche et penche loin d'un côté. Puis il descend bas d'un air renfrogné et se redresse lentement.
amie-motion-201-19-eat = { $pokemon } s'élève et penche vers l'avant pour regarder en bas, sa barre du haut se courbant. Puis il se redresse et cligne de l'œil.
amie-motion-201-19-happyB = { $pokemon } se balance d'un côté à l'autre, son œil joyeusement courbé, penchant loin sa barre du haut de chaque côté. Puis il se tient de nouveau droit.
amie-motion-201-19-hate = { $pokemon } se met de profil et se penche loin en arrière, l'œil fermé, s'enfonçant. Puis il refait face et cligne de l'œil.
amie-motion-201-20-eat = { $pokemon } penche vers l'avant et regarde le sol. Puis il remonte et oscille légèrement.
amie-motion-201-20-happyB = { $pokemon } bondit haut et fait une culbute complète dans les airs, son œil joyeusement courbé. Puis il retombe bien droit.
amie-motion-201-20-hate = { $pokemon } lance un regard noir et se détourne en partie, ramenant ses bras courbes contre lui. Puis il s'enfonce, toujours l'air furieux, et refait face.
amie-motion-201-21-eat = { $pokemon } bascule vers l'avant, si bien que sa boucle du haut descend et que son œil regarde en bas. Puis il se redresse en se balançant.
amie-motion-201-21-happyB = { $pokemon } penche, son œil joyeusement courbé. Puis il se couche à plat et tourne complètement sur lui-même, montrant son dos, et finit de face.
amie-motion-201-21-hate = { $pokemon } ferme fort son œil et pivote jusqu'à être de profil. Puis il repivote, l'œil toujours fermé, et fait face.
amie-motion-201-22-eat = { $pokemon } bascule vers l'avant, si bien que ses trois pointes descendent et s'écartent, et que son œil regarde en bas. Puis il remonte et oscille un peu d'un côté à l'autre.
amie-motion-201-22-happyB = { $pokemon } se retourne la tête en bas sur ses trois pointes, son œil joyeusement courbé. Puis il fait la roue complète et retombe bien droit.
amie-motion-201-22-hate = { $pokemon } fronce les sourcils et se tord un peu de chaque côté tour à tour, ses pointes penchant. Puis il se détend et fait face.
amie-motion-201-23-eat = { $pokemon } bascule vers l'avant, son œil regardant en bas. Puis il remonte un peu plus haut et balance ses quatre pointes d'un côté à l'autre.
amie-motion-201-23-happyB = { $pokemon } bondit haut et tourne complètement, montrant son dos. Puis il retombe et fait face.
amie-motion-201-23-hate = { $pokemon } plisse son œil et tourne d'un côté à l'autre. Puis il s'écroule à plat sur le dos et se redresse d'un coup.
amie-motion-201-24-eat = { $pokemon } bascule vers l'avant, si bien que ses deux bras descendent et que son œil regarde en bas. Puis il se redresse et penche d'un côté à l'autre sur sa tige.
amie-motion-201-24-happyB = { $pokemon } saute haut deux fois, son œil joyeusement courbé. Puis il retombe et reste immobile.
amie-motion-201-24-hate = { $pokemon } lance un regard noir et tourne d'un côté à l'autre. Puis il bascule vers l'avant, son œil regardant en bas, et se redresse.
amie-motion-201-25-eat = { $pokemon } hoche vers l'avant, son œil regardant en bas. Puis il se redresse et ferme un instant son œil.
amie-motion-201-25-happyB = { $pokemon } courbe joyeusement son œil et bondit haut, roulant sur le côté dans les airs. Puis il retombe bien droit.
amie-motion-201-25-hate = { $pokemon } fronce les sourcils et se balance fort d'un côté à l'autre, penchant presque à plat de chaque côté. Puis il se calme à la verticale.
amie-motion-201-26-eat = { $pokemon } penche un peu vers l'avant, si bien que sa longue pointe se penche en avant. Puis il se redresse et courbe un instant son œil de joie.
amie-motion-201-26-happyB = { $pokemon } courbe joyeusement son œil et balance sa longue pointe d'un côté, puis de l'autre. Puis il saute haut et retombe.
amie-motion-201-26-hate = { $pokemon } se balance d'un côté à l'autre et décolle du sol, pliant sa longue pointe d'un côté. Puis il retombe.
amie-motion-201-27-eat = { $pokemon } penche un peu vers l'avant, si bien que son crochet courbe se penche en avant. Puis il se redresse et oscille un peu d'un côté à l'autre.
amie-motion-201-27-happyB = { $pokemon } penche d'un côté et fait la roue complète, son crochet courbe se balançant sous lui. Puis il retombe bien droit.
amie-motion-201-27-hate = { $pokemon } ferme fort son œil et se balance d'un côté à l'autre, son crochet courbe vacillant. Puis il se calme à la verticale.

# Wobbuffet
amie-motion-202-drowse = { $pokemon } se balance et penche d'un côté tandis que sa bouche s'entrouvre. Puis il sursaute, se plaque un bras sur la tête et agite les deux bras.
amie-motion-202-eat = { $pokemon } ouvre grand la bouche un instant et la referme. Puis il reste immobile.
amie-motion-202-happyB = { $pokemon } lève un bras vers sa tête et rit, la bouche grande ouverte, tandis que sa queue dépasse derrière lui. Puis il rabaisse le bras d'un geste.
amie-motion-202-hate = { $pokemon } s'écarte, levant un bras devant son visage et lançant l'autre sur le côté, tandis que sa queue dépasse derrière lui. Puis il se redresse.
amie-motion-202-mad = { $pokemon } lance les deux bras sur les côtés et les agite avec colère. Puis il les tend droit sur les côtés et les laisse retomber.
amie-motion-202-moveC = { $pokemon } pose un bras sur sa hanche et agite l'autre bien haut au-dessus de sa tête, en riant. Puis il baisse les deux bras.

# Girafarig
amie-motion-203-eat = { $pokemon } mâche en hochant légèrement la tête. Puis il incline la tête d'un côté à l'autre.
amie-motion-203-happyB = { $pokemon } caracole, une patte avant levée, et tourne son corps de côté, montrant sa queue. Puis il lève de nouveau la patte et refait face.
amie-motion-203-hate = { $pokemon } se cabre, une patte avant levée, et tourne son corps de côté, ramenant la tête en arrière, la bouche ouverte. Puis il refait face.

# Pineco
amie-motion-204-happyB = { $pokemon } rebondit et s'écrase en largeur, écartant les plaques de sa coquille. Puis il recommence et se calme.
amie-motion-204-hate = { $pokemon } bascule en arrière et se détourne en partie, si bien que ses yeux se cachent derrière les plaques de sa coquille, en tremblant. Puis il refait face.

# Forretress
amie-motion-205-eat = { $pokemon } penche un peu vers l'avant et cligne des yeux. Puis il reste immobile.
amie-motion-205-happyB = { $pokemon } louche et incline sa coquille ronde d'un côté, puis la balance de l'autre. Puis il se remet à plat.
amie-motion-205-hate = { $pokemon } louche et referme sa coquille d'un coup, cachant ses yeux et ses piquants rouges. Puis il s'ouvre de nouveau.

# Dunsparce
amie-motion-206-eat = { $pokemon } ouvre la bouche et mâche. Puis il bat de haut en bas ses petites ailes.
amie-motion-206-happyB = { $pokemon } se baisse, les ailes étalées à plat. Puis il bondit, la bouche grande ouverte, et bat des ailes en retombant.
amie-motion-206-hate = { $pokemon } recule d'un coup et se tourne de côté, fouettant l'air de sa queue pointue sur le côté. Puis il fronce les sourcils et refait face.

# Gligar
amie-motion-207-eat = { $pokemon } se penche en avant et ouvre grand la bouche. Puis il mâche, ses pinces se balançant un peu.
amie-motion-207-happyB = { $pokemon } ferme joyeusement les yeux et pompe ses pinces de haut en bas. Puis il lève les deux pinces bien haut, les ailes grandes ouvertes.
amie-motion-207-hate = { $pokemon } fronce les sourcils et balaie son corps d'une pince, puis de l'autre. Puis il lève les deux pinces bien haut, les ailes déployées.

# Steelix
amie-motion-208-eat = { $pokemon } ouvre grand la gueule, puis la referme d'un coup et baisse la tête vers l'avant. Puis il se balance légèrement, la gueule fermée.
amie-motion-208-happyB = { $pokemon } incline son énorme tête d'un côté et la rejette en arrière, la gueule grande ouverte. Puis il la balance de l'autre côté et se redresse.
amie-motion-208-hate = { $pokemon } penche la tête d'un côté et ouvre grand son énorme gueule. Il la garde ouverte, puis la referme et se redresse.

# Snubbull
amie-motion-209-eat = { $pokemon } ouvre grand la bouche. Puis il baisse bien bas la tête, les oreilles écartées, et la balance un peu en mâchant.
amie-motion-209-happyB = { $pokemon } penche fort d'un côté, la bouche ouverte et un pied levé. Puis il penche de l'autre côté, ses oreilles battant.
amie-motion-209-hate = { $pokemon } grogne, puis baisse bien bas la tête et la secoue d'un côté à l'autre, ses oreilles battant. Puis il lève les yeux en grognant.

# Granbull
amie-motion-210-eat = { $pokemon } renverse la tête et ouvre grand la bouche. Puis il la ferme et baisse la tête en mâchant.
amie-motion-210-happyB = { $pokemon } écarte grand les bras et sourit, les yeux fermés. Puis il rejette la tête en arrière, la bouche grande ouverte.
amie-motion-210-hate = { $pokemon } tord fort sa tête vers le bas d'un côté et tient ses poings écartés de son corps. Puis il se retourne en grognant.

# Qwilfish
amie-motion-211-eat = { $pokemon } oscille légèrement et remue ses lèvres arrondies.
amie-motion-211-happyB = { $pokemon } descend, puis remonte et se renverse pour montrer son ventre pâle et sa queue dessous. Puis il se rabaisse.
amie-motion-211-hate = { $pokemon } se gonfle beaucoup, ses piquants dressés, l'air furieux. Puis il retrouve sa taille habituelle.

# Scizor
amie-motion-212-eat = { $pokemon } baisse légèrement la tête et reste sinon immobile.
amie-motion-212-happyB = { $pokemon } s'accroupit bien bas, baissant la tête et écartant ses pinces sur les côtés. Puis il se relève.
amie-motion-212-hate = { $pokemon } tord tout son corps de côté et s'écarte, ses ailes dépassant derrière lui. Puis il refait face.

# Shuckle
amie-motion-213-drowse = { $pokemon } ferme les yeux et sa tête penche d'un côté, puis s'affaisse vers l'avant. Puis il se redresse d'un coup, la bouche ouverte.
amie-motion-213-eat = { $pokemon } ouvre la bouche et raccourcit son cou vers le bas, puis le rallonge vers le haut. Puis il mâche, les yeux fermés.
amie-motion-213-happyB = { $pokemon } écrase son cou tout court, les yeux fermés. Puis il étire son cou bien haut, la bouche ouverte.
amie-motion-213-hate = { $pokemon } grimace, puis rentre toute sa tête et ses pattes dans sa carapace. Après un moment, il les ressort.
amie-motion-213-moveC = { $pokemon } balance son long cou d'un côté, la bouche ouverte. Puis il le balance de l'autre côté et revient.

# Heracross
amie-motion-214-eat = { $pokemon } baisse la tête et la corne vers l'avant, puis les relève. Puis il les hoche légèrement.
amie-motion-214-happyB = { $pokemon } lance les deux bras bien haut au-dessus de sa tête. Puis il les plie sur ses côtés et les baisse.
amie-motion-214-hate = { $pokemon } baisse la tête et balance sa corne fort d'un côté, puis de l'autre, tordant tout son corps. Puis il se redresse.

# Sneasel
amie-motion-215-drowse = { $pokemon } ferme les yeux, les bras croisés, et sa tête s'enfonce vers l'avant. Puis il relève la tête, les yeux ouverts.
amie-motion-215-eat = { $pokemon } baisse légèrement la tête, les bras croisés, et reste sinon immobile.
amie-motion-215-happyB = { $pokemon } sourit, les yeux fermés. Puis il se tourne de côté, montrant les piquants de son dos, et cligne de l'œil par-dessus son épaule.
amie-motion-215-hate = { $pokemon } lance les bras sur les côtés. Puis il les croise et se tourne de côté, levant le menton pour s'écarter, les yeux mi-clos.

# Teddiursa
amie-motion-216-drowse = { $pokemon } retire sa patte de sa bouche et laisse sa tête rouler loin d'un côté, les yeux fermés. Puis il se réveille en sursaut, les bras écartés.
amie-motion-216-eat = { $pokemon } ouvre grand la bouche, une patte levée à côté. Puis il hoche la tête en mâchant.
amie-motion-216-happyB = { $pokemon } ouvre grand les bras et renverse la tête avec un large sourire, se balançant d'un côté à l'autre. Puis il baisse la tête vers l'avant.
amie-motion-216-hate = { $pokemon } fronce les sourcils et serre ses pattes contre sa poitrine. Puis il secoue la tête d'un côté à l'autre.

# Ursaring
amie-motion-217-drowse = { $pokemon } ferme les yeux et s'affaisse, sa tête s'enfonçant entre ses épaules. Puis il se redresse d'un coup, les bras écartés de ses flancs.
amie-motion-217-eat = { $pokemon } lève la tête et ouvre grand la bouche. Puis il baisse la tête vers l'avant et mâche en hochant légèrement la tête.
amie-motion-217-happyB = { $pokemon } se penche en arrière, les bras écartés de ses flancs et la bouche grande ouverte. Puis il se redresse.
